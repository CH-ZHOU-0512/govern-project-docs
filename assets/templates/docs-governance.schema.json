{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Documentation governance configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "docsRoot",
    "generatedRoot",
    "activeDirectories",
    "excludedFromMetadata",
    "requiredMetadata",
    "allowedStatuses",
    "lineLimits",
    "routingPaths",
    "routingPatterns",
    "stableIdPrefixes"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "docsRoot": { "$ref": "#/$defs/repositoryPath" },
    "generatedRoot": { "$ref": "#/$defs/repositoryPath" },
    "activeDirectories": { "$ref": "#/$defs/uniqueStrings" },
    "excludedFromMetadata": { "$ref": "#/$defs/uniqueStrings" },
    "requiredMetadata": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
    "allowedStatuses": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
    "lineLimits": {
      "type": "object",
      "required": ["default"],
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      }
    },
    "routingPaths": { "$ref": "#/$defs/uniqueStrings" },
    "routingPatterns": { "$ref": "#/$defs/uniqueStrings" },
    "stableIdPrefixes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9]*$"
      }
    }
  },
  "$defs": {
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "not": { "pattern": "^(?:[A-Za-z]:[\\\\/]|/)" }
    },
    "uniqueStrings": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "nonEmptyUniqueStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
